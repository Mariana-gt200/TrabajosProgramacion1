<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.viewController.PuntosViewController">
    <padding>
        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/>
    </padding>
    <children>
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Sistema de Puntos, Rangos y Canje de Beneficios"/>

        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <children>
                <Label text="Cliente:"/>
                <ComboBox fx:id="cmbCliente" onAction="#onClienteSeleccionado" prefWidth="310.0"/>
                <Label fx:id="lblPuntosAcumulados" style="-fx-font-weight: bold;" text="Acumulados: -"/>
                <Label fx:id="lblPuntosDisponibles" style="-fx-font-weight: bold;" text="Disponibles: -"/>
                <Label fx:id="lblRango" style="-fx-font-weight: bold;" text="Rango: -"/>
            </children>
        </HBox>

        <Label fx:id="lblBeneficios" text="Beneficios activos: -"/>

        <Separator/>

        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Canjear Puntos Disponibles"/>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Button onAction="#onCanjearDescuento" text="100 pts: 10% desc. comisión"/>
                <Button onAction="#onCanjearMesSinCargos" text="500 pts: 1 mes sin cargos retiros"/>
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Monedero para bono:"/>
                <ComboBox fx:id="cmbMonederoBono" prefWidth="260.0"/>
                <Button onAction="#onCanjearBono" text="1000 pts: Bono de $50 en monedero"/>
            </children>
        </HBox>

        <Separator/>

        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Historial de Transacciones con Puntos"/>

        <TableView fx:id="tblHistorialPuntos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="tbcId" prefWidth="170.0" text="ID Transacción"/>
                <TableColumn fx:id="tbcTipo" prefWidth="170.0" text="Tipo"/>
                <TableColumn fx:id="tbcMonto" prefWidth="180.0" text="Monto"/>
                <TableColumn fx:id="tbcFecha" prefWidth="180.0" text="Fecha"/>
                <TableColumn fx:id="tbcPuntos" prefWidth="190.0" text="Puntos generados"/>
            </columns>
        </TableView>
    </children>
</VBox>
