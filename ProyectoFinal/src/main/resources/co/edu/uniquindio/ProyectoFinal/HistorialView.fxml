<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.viewController.HistorialViewController">
    <padding>
        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/>
    </padding>
    <children>
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Historial de Transacciones"/>

        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <children>
                <Label text="Cliente:"/>
                <ComboBox fx:id="cmbCliente" onAction="#onClienteSeleccionado" prefWidth="320.0"/>
                <Label fx:id="lblPuntos" style="-fx-font-weight: bold;" text="Puntos acumulados: -"/>
                <Label fx:id="lblRango" style="-fx-font-weight: bold;" text="Rango: -"/>
            </children>
        </HBox>

        <TableView fx:id="tblTransacciones" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="tbcId" prefWidth="160.0" text="ID Transacción"/>
                <TableColumn fx:id="tbcTipo" prefWidth="160.0" text="Tipo"/>
                <TableColumn fx:id="tbcMonto" prefWidth="180.0" text="Monto ($)"/>
                <TableColumn fx:id="tbcFecha" prefWidth="180.0" text="Fecha"/>
                <TableColumn fx:id="tbcEstado" prefWidth="210.0" text="Estado"/>
            </columns>
        </TableView>

        <HBox spacing="10.0">
            <children>
                <Button onAction="#onRevertir" text="Revertir transacción seleccionada"/>
            </children>
        </HBox>
    </children>
</VBox>