<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TabPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="co.edu.uniquindio.poo.viewController.MonederoViewController"
         tabClosingPolicy="UNAVAILABLE">
    <tabs>

        <!-- ===== PESTAÑA CLIENTES ===== -->
        <Tab text="Clientes">
            <content>
                <VBox spacing="12">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>

                    <GridPane hgap="10" vgap="8">
                        <Label text="Identificación" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtIdCliente" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Nombre" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtNombreCliente" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                        <Label text="Email" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtEmailCliente" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Teléfono" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtTelefonoCliente" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                        <Label text="Canal de notificación" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <ComboBox fx:id="cmbCanalCliente" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    </GridPane>

                    <HBox spacing="10">
                        <Button text="Registrar" onAction="#onRegistrarCliente"/>
                        <Button text="Actualizar" onAction="#onActualizarCliente"/>
                        <Button text="Eliminar" onAction="#onEliminarCliente"/>
                        <Button text="Limpiar" onAction="#onLimpiarCliente"/>
                    </HBox>

                    <Label fx:id="lblMensajeCliente"/>

                    <TableView fx:id="tablaClientes" prefHeight="320">
                        <columns>
                            <TableColumn fx:id="colIdCliente" text="Identificación" prefWidth="120"/>
                            <TableColumn fx:id="colNombreCliente" text="Nombre" prefWidth="160"/>
                            <TableColumn fx:id="colEmailCliente" text="Email" prefWidth="200"/>
                            <TableColumn fx:id="colTelefonoCliente" text="Teléfono" prefWidth="120"/>
                            <TableColumn fx:id="colCanalCliente" text="Canal" prefWidth="110"/>
                            <TableColumn fx:id="colRangoCliente" text="Rango" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </content>
        </Tab>

    </tabs>
</TabPane>
