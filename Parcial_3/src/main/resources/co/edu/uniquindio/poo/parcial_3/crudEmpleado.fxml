<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.parcial_3.viewController.EmpleadoViewController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="encabezado">
            <VBox spacing="2.0">
                <Label styleClass="titulo" text="Gestión de empleados"/>
                <Label styleClass="subtitulo" text="Panadería El Trigal"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#onVolver" styleClass="boton-secundario" text="Volver al inicio"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="20.0"/>
            </padding>

            <VBox maxWidth="330.0" minWidth="330.0" spacing="10.0" styleClass="tarjeta">
                <Label styleClass="titulo-tarjeta" text="Registrar empleado"/>

                <Label styleClass="etiqueta" text="Tipo de empleado"/>
                <ComboBox fx:id="cmbTipoEmpleado" maxWidth="Infinity" onAction="#onTipoEmpleadoCambiado"/>

                <Label styleClass="etiqueta" text="Nombre"/>
                <TextField fx:id="txtNombre" promptText="Ej: Ana"/>

                <Label styleClass="etiqueta" text="Documento"/>
                <TextField fx:id="txtDocumento" promptText="Ej: 1001"/>

                <Label styleClass="etiqueta" text="Código único"/>
                <TextField fx:id="txtCodigo" promptText="Ej: E-01"/>

                <Label styleClass="etiqueta" text="Minutos disponibles al comenzar el turno"/>
                <TextField fx:id="txtMinutos" promptText="Ej: 100"/>

                <VBox fx:id="boxCaja" managed="false" spacing="10.0" visible="false">
                    <Label styleClass="etiqueta" text="Número de caja"/>
                    <TextField fx:id="txtCaja" promptText="Ej: Caja 1"/>
                </VBox>

                <Button maxWidth="Infinity" onAction="#onRegistrarEmpleado" styleClass="boton-primario"
                        text="Registrar empleado"/>
            </VBox>

            <VBox spacing="10.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                <Label styleClass="titulo-tarjeta" text="Empleados (en orden de registro)"/>
                <TableView fx:id="tblListEmpleado" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="tbcCodigo" text="Código"/>
                        <TableColumn fx:id="tbcNombre" text="Nombre"/>
                        <TableColumn fx:id="tbcDocumento" text="Documento"/>
                        <TableColumn fx:id="tbcTipo" text="Tipo"/>
                        <TableColumn fx:id="tbcMinutos" text="Min. disponibles"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="barra-estado">
            <Label fx:id="lblEstado" text="Listo."/>
        </HBox>
    </bottom>
</BorderPane>